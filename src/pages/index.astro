---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
---

<Layout title="Projects | Gareth Griffiths" bodyClass="projects-page">
  <main class="page page--projects">
    <section class="projects-grid" aria-label="Projects">
      {
        projects.map((project) => (
          <div class="projects-row">
            <a class="project-card" href={`/projects/${project.slug}`}>
              <img
                class="project-card__image"
                src={project.coverImage}
                alt={project.description}
                loading="lazy"
              />
              <div class="project-card__label">
                <h2>{project.title}</h2>
              </div>
            </a>
          </div>
        ))
      }
    </section>
  </main>

  <script is:inline>
    const projectsGrid = document.querySelector(".projects-grid");

    if (projectsGrid) {
      const maxRowWidth = 88;
      const maxRowOffset = 22;
      const maxCardsPerRow = 2;
      const roundToTenth = (value) => Math.round(value * 10) / 10;
      const randomBetween = (min, max) =>
        roundToTenth(Math.random() * (max - min) + min);
      const makeRowConfig = () => ({
        cards: [],
        gap: randomBetween(1.2, 3),
        offset: 0,
      });

      const cards = Array.from(
        projectsGrid.querySelectorAll(".project-card"),
      ).map((card) => {
        const width = randomBetween(30, 47);
        const rotation = randomBetween(-10, 10);

        card.style.setProperty("--card-width", `${width}vw`);
        card.style.setProperty("--card-rotation", `${rotation}deg`);

        return { element: card, width };
      });

      const rows = cards.reduce((allRows, card) => {
        let row = allRows.at(-1);

        if (!row) {
          row = makeRowConfig();
          allRows.push(row);
        }

        const rowWidth = row.cards.reduce(
          (total, entry) => total + entry.width,
          0,
        );
        const gapWidth = row.cards.length * row.gap;
        const nextWidth = rowWidth + gapWidth + card.width;

        if (
          row.cards.length > 0 &&
          (row.cards.length >= maxCardsPerRow || nextWidth > maxRowWidth)
        ) {
          row = makeRowConfig();
          allRows.push(row);
        }

        row.cards.push(card);
        return allRows;
      }, []);

      const rowElements = rows.map((row) => {
        const cardsWidth = row.cards.reduce(
          (total, card) => total + card.width,
          0,
        );
        const contentWidth =
          cardsWidth + Math.max(0, row.cards.length - 1) * row.gap;
        const availableOffset = Math.max(
          0,
          Math.min(100 - contentWidth, maxRowOffset),
        );
        row.offset = randomBetween(0, availableOffset);

        const rowElement = document.createElement("div");
        rowElement.className = "projects-row";
        rowElement.style.setProperty("--row-gap", `${row.gap}vw`);
        rowElement.style.setProperty("--row-offset", `${row.offset}vw`);

        row.cards.forEach((card) => {
          rowElement.append(card.element);
        });

        return rowElement;
      });

      projectsGrid.replaceChildren(...rowElements);

      const projectImages = Array.from(
        projectsGrid.querySelectorAll(".project-card__image"),
      );

      function scheduleDrips() {
        requestAnimationFrame(function () {
          requestAnimationFrame(spawnDrips);
        });
      }

      // ── Paint drip effect ──────────────────────────────
      function spawnDrips() {
        var page = document.querySelector(".page--projects");
        if (!page) return;

        var existing = page.querySelector(".drip-layer");
        if (existing) existing.remove();

        var dripLayer = document.createElement("div");
        dripLayer.className = "drip-layer";
        dripLayer.setAttribute("aria-hidden", "true");
        page.insertBefore(dripLayer, page.firstChild);

        var pageRect = page.getBoundingClientRect();
        var COLORS = [
          "#e8001d",
          "#0047ab",
          "#ffd700",
          "#228b22",
          "#8b00ff",
          "#ff6600",
        ];

        document.querySelectorAll(".project-card").forEach(function (card) {
          var cardRect = card.getBoundingClientRect();
          var relBottom = cardRect.bottom - pageRect.top;
          var relMid = cardRect.top + cardRect.height / 2 - pageRect.top;
          var relLeft = cardRect.left - pageRect.left;
          var count = Math.floor(Math.random() * 12) + 6;

          for (var i = 0; i < count; i++) {
            var color = COLORS[Math.floor(Math.random() * COLORS.length)];
            var stemW = Math.random() * 25 + 12;
            var bulbR = stemW / 2;
            var stemH = Math.random() * 180 + 140;
            var svgW = Math.ceil(stemW + 4);
            var cx = svgW / 2;
            var xPos =
              relLeft + (0.1 + Math.random() * 0.8) * cardRect.width - cx;
            var delayMs = Math.random() * 500;
            var durMs = Math.random() * 12000 + 6000;
            var timing = {
              duration: durMs,
              delay: delayMs,
              easing: "ease-in-out",
              fill: "both",
            };

            var el = document.createElement("div");
            el.className = "drip";
            el.style.left = xPos + "px";
            el.style.top = relMid + "px";

            // Stem SVG — scales on Y from the top
            var ns = "http://www.w3.org/2000/svg";
            var stemSvg = document.createElementNS(ns, "svg");
            stemSvg.setAttribute("width", svgW);
            stemSvg.setAttribute("height", stemH.toFixed(2));
            stemSvg.style.display = "block";
            stemSvg.style.transformOrigin = "50% 0%";
            var stemRect = document.createElementNS(ns, "rect");
            stemRect.setAttribute("x", (cx - stemW / 2).toFixed(2));
            stemRect.setAttribute("y", "0");
            stemRect.setAttribute("width", stemW.toFixed(2));
            stemRect.setAttribute("height", stemH.toFixed(2));
            stemRect.setAttribute("rx", bulbR.toFixed(2));
            stemRect.setAttribute("fill", color);
            stemSvg.appendChild(stemRect);
            stemSvg.animate(
              [{ transform: "scaleY(0.04)" }, { transform: "scaleY(1)" }],
              timing,
            );

            // Bulb SVG — translates to track the stem bottom (no scale)
            var bulbSize = Math.ceil(bulbR * 2 + 2);
            var bulbSvg = document.createElementNS(ns, "svg");
            bulbSvg.setAttribute("width", bulbSize);
            bulbSvg.setAttribute("height", bulbSize);
            bulbSvg.style.position = "absolute";
            bulbSvg.style.left = (cx - bulbR - 1).toFixed(2) + "px";
            bulbSvg.style.top = (stemH - bulbR * 1.7).toFixed(2) + "px";
            var bulbCircle = document.createElementNS(ns, "circle");
            bulbCircle.setAttribute("cx", (bulbSize / 2).toFixed(2));
            bulbCircle.setAttribute("cy", bulbR.toFixed(2));
            bulbCircle.setAttribute("r", bulbR.toFixed(2));
            bulbCircle.setAttribute("fill", color);
            bulbSvg.appendChild(bulbCircle);
            var initialOffset = (stemH * (0.04 - 1)).toFixed(2);
            bulbSvg.animate(
              [
                { transform: "translateY(" + initialOffset + "px)" },
                { transform: "translateY(0px)" },
              ],
              timing,
            );

            el.appendChild(stemSvg);
            el.appendChild(bulbSvg);
            dripLayer.appendChild(el);
          }
        });
      }

      if (document.readyState === "complete") {
        scheduleDrips();
      } else {
        window.addEventListener("load", scheduleDrips, { once: true });
      }

      projectImages.forEach(function (image) {
        if (!image.complete) {
          image.addEventListener("load", scheduleDrips, { once: true });
          image.addEventListener("error", scheduleDrips, { once: true });
        }
      });

      var resizeTimer;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(scheduleDrips, 300);
      });
    }
  </script>
</Layout>
