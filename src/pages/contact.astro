---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Gareth Griffiths" bodyClass="contact-page">
  <main class="page">
    <section class="contact-grid">
      <div class="contact-copy">
        <p class="contact-copy__eyebrow">Contact</p>
        <p>
          For commissions, collaborations, or conversations about new work, get
          in touch directly. I'm always interested to hear about projects that
          could be a good fit for my practice. I'm currently available for
          freelance work, and open to studio introductions.
        </p>
        <p>
          Project enquiries, freelance opportunities, and studio introductions
          are all welcome. Include a short outline, timeline, and any useful
          context for the brief.
        </p>
      </div>

      <aside class="contact-panel">
        <p class="section-title">Direct</p>
        <p class="contact-detail">
          <a href="mailto:hello@gareth-griffiths.com"
            >hello@gareth-griffiths.com</a
          >
        </p>
      </br>
        <p class="section-title">Social</p>
        <p class="contact-detail">
          <a
            href="https://www.linkedin.com/in/gngriffiths/"
            target="_blank"
            rel="noreferrer">LinkedIn</a
          >
        </p>
        <p class="contact-detail">
          <a
            href="https://github.com/gngriffiths"
            target="_blank"
            rel="noreferrer">GitHub</a
          >
        </p>
      </aside>
    </section>
  </main>
</Layout>
